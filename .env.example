# === Aplicação / API ===
APP_ENV=development
APP_LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# === PostgreSQL + pgvector ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fleetpulse
POSTGRES_USER=fleetpulse
POSTGRES_PASSWORD=fleetpulse_dev_pass
DATABASE_URL=postgresql+asyncpg://fleetpulse:fleetpulse_dev_pass@localhost:5432/fleetpulse

# === Redis (Fila, DLQ, Idempotência, Rate Limit e Pub/Sub SSE) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
ALERT_DEDUP_WINDOW_SECONDS=300
RATE_LIMIT_PER_MINUTE=120
WORKER_MAX_RETRIES=3

# === Neo4j (Grafo de Topologia, Firmware & Runbooks) ===
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fleetpulse_dev_neo4j

# === Ollama Local & Hybrid AI Router ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TRIAGE_MODEL=phi4-mini:latest
OLLAMA_REASONING_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_TIMEOUT_SECONDS=30

# === Cache Semântico ===
SEMANTIC_CACHE_THRESHOLD=0.90
SEMANTIC_CACHE_TTL_SECONDS=3600

# === Fallback Cloud (Opcional — desabilitado por padrão) ===
HYBRID_CLOUD_FALLBACK_ENABLED=false
CLOUD_LLM_PROVIDER=
CLOUD_LLM_MODEL=
CLOUD_LLM_API_KEY=
